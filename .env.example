# Environment Configuration Template
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=development  # development, test, production

# Cloud Models Control (Cost Optimization)
# Set to false in development to use only Ollama models (FREE)
# Set to true in production to enable OpenAI, Anthropic, and Google models
ENABLE_CLOUD_MODELS=false

# Database
POSTGRES_USER=contract_test
POSTGRES_PASSWORD=contract_test_pwd
POSTGRES_DB=contract_test_db
DATABASE_URL=postgresql://contract_test:contract_test_pwd@localhost:5432/contract_test_db

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API Keys (Only required if ENABLE_CLOUD_MODELS=true)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Ollama (Local LLM - No API Key Required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MISTRAL_MODEL=mistral:latest
OLLAMA_LLAMA_MODEL=llama3.1:latest

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log

# Agent Configuration
MAX_ITERATIONS=5
TIMEOUT_SECONDS=300

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PASSWORD=admin
